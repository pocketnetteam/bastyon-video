## Following & Followers

Implement ActivityPub follow mechanism:

```typescript
// ✅ GOOD - Send follow activity
export async function sendFollow(
  byActor: MActorSignature,
  targetActor: MActorUrl
): Promise<void> {
  const activity: ActivityFollow = {
    type: 'Follow',
    id: buildUUID(),
    actor: byActor.url,
    object: targetActor.url
  }

  // Create follow in database
  const follow = await ActorFollowModel.create({
    actorId: byActor.id,
    targetActorId: targetActor.id,
    state: 'pending'
  })

  // Send activity
  await signAndSendActivity(activity, byActor, targetActor.inboxUrl)

  logger.info('Follow request sent', {
    follower: byActor.url,
    following: targetActor.url
  })
}

// ✅ GOOD - Process follow request
async function processFollowActivity(
  activity: ActivityFollow,
  byActor: MActorSignature
): Promise<void> {
  const targetActor = await getLocalActorByUrl(activity.object as string)
  
  if (!targetActor) {
    logger.warn('Target actor not found', { url: activity.object })
    return
  }

  // Check if auto-accept follows
  const autoAccept = await shouldAutoAcceptFollow(byActor, targetActor)

  const follow = await ActorFollowModel.create({
    actorId: byActor.id,
    targetActorId: targetActor.id,
    state: autoAccept ? 'accepted' : 'pending'
  })

  if (autoAccept) {
    // Send Accept activity
    const acceptActivity: ActivityAccept = {
      type: 'Accept',
      id: buildUUID(),
      actor: targetActor.url,
      object: activity
    }

    await signAndSendActivity(acceptActivity, targetActor, byActor.inboxUrl)

    logger.info('Follow request accepted', {
      follower: byActor.url,
      following: targetActor.url
    })
  } else {
    logger.info('Follow request pending approval', {
      follower: byActor.url,
      following: targetActor.url
    })
  }
}
```

## Broadcasting

Broadcast activities to all followers:

```typescript
// ✅ GOOD - Broadcast activity via job queue
export async function broadcastToFollowers(
  activity: Activity,
  byActor: MActorSignature,
  options: {
    contextType?: 'Video' | 'VideoChannel' | 'Account'
  } = {}
): Promise<void> {
  // Get all followers
  const followers = await ActorFollowModel.listAcceptedFollowerSharedInboxUrls(byActor)

  if (followers.length === 0) {
    logger.info('No followers to broadcast to', { actorUrl: byActor.url })
    return
  }

  // Group by shared inbox for efficiency
  const inboxes = new Set(followers.map(f => f.sharedInboxUrl || f.inboxUrl))

  logger.info('Broadcasting activity', {
    activityType: activity.type,
    actorUrl: byActor.url,
    inboxCount: inboxes.size
  })

  // Create job for each inbox
  const jobs = Array.from(inboxes).map(inbox => ({
    type: 'activitypub-http-broadcast' as const,
    payload: {
      uris: [inbox],
      activity,
      actorId: byActor.id
    }
  }))

  await JobQueue.Instance.createJobs(jobs)
}
```

## Error Handling

Handle federation errors gracefully:

```typescript
// ✅ GOOD - Graceful error handling
export async function sendActivityToInbox(
  activity: Activity,
  byActor: MActorSignature,
  inboxUrl: string,
  retries = 0
): Promise<void> {
  try {
    await signAndSendActivity(activity, byActor, inboxUrl)
  } catch (err) {
    // Determine if we should retry
    if (isRetryableError(err) && retries < 3) {
      logger.warn('Retrying activity send', {
        inboxUrl,
        retries: retries + 1,
        error: err.message
      })
      
      await new Promise(resolve => setTimeout(resolve, 5000 * (retries + 1)))
      return sendActivityToInbox(activity, byActor, inboxUrl, retries + 1)
    }

    // Log and give up
    logger.error('Failed to send activity after retries', {
      inboxUrl,
      activityType: activity.type,
      error: err
    })

    // Mark actor as unreachable if persistent failure
    if (retries >= 3) {
      await markActorAsUnreachable(inboxUrl)
    }
  }
}

function isRetryableError(err: any): boolean {
  // Network errors
  if (err.code === 'ETIMEDOUT' || err.code === 'ECONNREFUSED') {
    return true
  }

  // 5xx errors
  if (err.statusCode >= 500 && err.statusCode < 600) {
    return true
  }

  // 4xx errors are not retryable
  return false
}
```
