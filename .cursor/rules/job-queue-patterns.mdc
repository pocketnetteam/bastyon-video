## Error Handling in Jobs

Handle errors properly with retry logic:

```typescript
// ✅ GOOD - Proper error handling
export async function processVideoImport(
  job: Job<VideoImportPayload>
): Promise<void> {
  const payload = job.data

  try {
    const videoImport = await VideoImportModel.findById(payload.videoImportId)
    if (!videoImport) {
      throw new Error(`Video import ${payload.videoImportId} not found`)
    }

    // Check if this is a retry
    if (job.attemptsMade > 0) {
      logger.warn('Retrying video import', {
        importId: videoImport.id,
        attempt: job.attemptsMade
      })
    }

    await performImport(videoImport, job)

    // Update state on success
    videoImport.state = VideoImportState.SUCCESS
    await videoImport.save()

  } catch (error) {
    // Determine if error is recoverable
    if (isRecoverableError(error)) {
      logger.warn('Recoverable error in video import', { error })
      throw error  // Will retry
    } else {
      logger.error('Fatal error in video import', { error })
      
      // Mark as failed and don't retry
      const videoImport = await VideoImportModel.findById(payload.videoImportId)
      if (videoImport) {
        videoImport.state = VideoImportState.FAILED
        videoImport.error = error.message
        await videoImport.save()
      }
      
      return  // Don't throw - prevents retry
    }
  }
}

function isRecoverableError(error: any): boolean {
  // Network errors, timeouts - recoverable
  if (error.code === 'ETIMEDOUT' || error.code === 'ECONNREFUSED') {
    return true
  }
  
  // 4xx errors - not recoverable
  if (error.statusCode >= 400 && error.statusCode < 500) {
    return false
  }
  
  // 5xx errors - recoverable
  if (error.statusCode >= 500) {
    return true
  }
  
  return false
}
```

## Progress Tracking

Update job progress for long-running operations:

```typescript
// ✅ GOOD - Progress tracking
export async function processVideoTranscoding(
  job: Job<VideoTranscodingPayload>
): Promise<void> {
  const video = await loadVideo(job.data.videoId)
  
  // Initial setup
  await job.progress(5)
  
  // Download (if remote)
  if (video.remote) {
    await downloadVideo(video, (percent) => {
      job.progress(5 + (percent * 0.2))  // 5-25%
    })
  }
  
  await job.progress(25)
  
  // Transcode
  await transcodeVideo(video, (percent) => {
    job.progress(25 + (percent * 0.5))  // 25-75%
  })
  
  await job.progress(75)
  
  // Upload to storage
  await uploadVideo(video, (percent) => {
    job.progress(75 + (percent * 0.2))  // 75-95%
  })
  
  await job.progress(95)
  
  // Cleanup
  await cleanup(video)
  
  await job.progress(100)
}
```

## Job Cleanup

Implement proper cleanup for failed/completed jobs:

```typescript
// ✅ GOOD - Cleanup on completion/failure
export async function processMoveToObjectStorage(
  job: Job<MoveObjectStoragePayload>
): Promise<void> {
  const { videoId } = job.data
  const video = await VideoModel.load(videoId)
  
  const tempFiles: string[] = []
  
  try {
    // Move files
    for (const file of video.VideoFiles) {
      const tempPath = await downloadToTemp(file)
      tempFiles.push(tempPath)
      
      await uploadToObjectStorage(file, tempPath)
      await file.save()
    }
    
    // Success - remove local files
    await video.removeLocalFiles()
    
  } catch (error) {
    // Failure - rollback
    logger.error('Failed to move to object storage, rolling back', { error })
    
    for (const file of video.VideoFiles) {
      if (file.objectStorageUrl) {
        await deleteFromObjectStorage(file.objectStorageUrl)
        file.objectStorageUrl = null
        await file.save()
      }
    }
    
    throw error
    
  } finally {
    // Always cleanup temp files
    for (const tempFile of tempFiles) {
      await remove(tempFile)
    }
  }
}
```
