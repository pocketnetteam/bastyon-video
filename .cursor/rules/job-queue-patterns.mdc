# Job Queue Patterns

## Job Handler Structure

Follow consistent structure for job handlers:

```typescript
import { Job } from 'bull'
import { logger } from '@server/helpers/logger'
import { VideoModel } from '@server/models/video/video'

// ✅ GOOD - Define payload interface
export interface VideoTranscodingPayload {
  type: 'new-resolution' | 'optimize' | 'merge-audio'
  videoId: number
  resolution?: number
  isNewVideo?: boolean
}

// ✅ GOOD - Main processing function
export async function processVideoTranscoding(
  job: Job<VideoTranscodingPayload>
): Promise<void> {
  const payload = job.data

  logger.info('Processing video transcoding job', { payload, jobId: job.id })

  // Load video
  const video = await VideoModel.loadAndPopulateAccountAndServerAndTags(payload.videoId)
  if (!video) {
    logger.error('Video not found for transcoding', { videoId: payload.videoId })
    throw new Error(`Video ${payload.videoId} does not exist`)
  }

  try {
    // Update job progress
    await job.progress(10)

    // Perform transcoding based on type
    switch (payload.type) {
      case 'new-resolution':
        await transcodeNewResolution(video, payload.resolution!, job)
        break
      case 'optimize':
        await optimizeOriginalVideo(video, job)
        break
      case 'merge-audio':
        await mergeAudioVideoFiles(video, job)
        break
    }

    await job.progress(100)

    logger.info('Video transcoding completed', {
      videoId: video.id,
      type: payload.type
    })
  } catch (error) {
    logger.error('Video transcoding failed', {
      error,
      videoId: video.id,
      payload
    })
    throw error
  }
}

// Helper functions
async function transcodeNewResolution(
  video: MVideoFullLight,
  resolution: number,
  job: Job
): Promise<void> {
  // Implementation
  await job.progress(50)
  // ...
}
```

## Job Queue Configuration

Configure job queues properly:

```typescript
// ✅ GOOD - Queue configuration
import Queue, { Job, JobOptions } from 'bull'
import { redis } from '@server/initializers/redis'

export class JobQueue {
  private static instance: JobQueue

  private queues: Map<string, Queue.Queue> = new Map()

  private constructor() {}

  static get Instance() {
    return this.instance || (this.instance = new this())
  }

  init() {
    const jobTypes: string[] = [
      'video-transcoding',
      'activitypub-http-broadcast',
      'activitypub-http-unicast',
      'activitypub-http-fetcher',
      'email',
      'video-import',
      'move-to-object-storage'
    ]

    for (const jobType of jobTypes) {
      const queue = this.createQueue(jobType)
      this.queues.set(jobType, queue)
    }
  }

  private createQueue(jobType: string): Queue.Queue {
    const queue = new Queue(jobType, {
      redis: {
        host: redis.hostname,
        port: redis.port,
        password: redis.auth
      },
      defaultJobOptions: {
        removeOnComplete: 100,  // Keep last 100 completed jobs
        removeOnFail: 1000,     // Keep last 1000 failed jobs
        attempts: 3,
        backoff: {
          type: 'exponential',
          delay: 5000
        }
      }
    })

    // Setup processor
    queue.process(this.getProcessor(jobType))

    // Setup event handlers
    queue.on('completed', (job: Job) => {
      logger.info('Job completed', { jobId: job.id, jobType })
    })

    queue.on('failed', (job: Job, err: Error) => {
      logger.error('Job failed', { jobId: job.id, jobType, error: err })
    })

    return queue
  }
}
```

## Creating Jobs

Use proper job creation patterns:

```typescript
// ✅ GOOD - Create job with proper options
async function createTranscodingJob(
  video: MVideo,
  resolution: number,
  priority: number = 10
): Promise<void> {
  const payload: VideoTranscodingPayload = {
    type: 'new-resolution',
    videoId: video.id,
    resolution,
    isNewVideo: false
  }

  const jobOptions: JobOptions = {
    priority,
    delay: 0,
    attempts: 3,
    backoff: {
      type: 'exponential',
      delay: 5000
    }
  }

  await JobQueue.Instance.createJob({
    type: 'video-transcoding',
    payload,
    options: jobOptions
  })

  logger.info('Transcoding job created', { videoId: video.id, resolution })
}
```

